# Capability sources for the bridge. These are Worker bindings, never client code.
#
# The hosted demo source (see src/sources/cloud-source.ts). Optional: the worker
# falls back to the deployed default when this is unset.
MCP_CLOUD_URL=https://hitch-capability-source.example.workers.dev/mcp

# An n8n MCP Server Trigger endpoint, if you have one.
# Production path shape: https://<your-n8n>/mcp/<trigger-path>
MCP_N8N_URL=
# Set with `wrangler secret put MCP_N8N_TOKEN`. Never commit a real value.
MCP_N8N_TOKEN=
