{
  "name": "hitch",
  "version": "0.1.0",
  "private": true,
  "description": "Bring capabilities you already own into any WebMCP experience.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "deploy:source": "wrangler deploy --config wrangler.source.jsonc",
    "capture": "node scripts/capture.mjs docs/hero.png",
    "test": "npm run test:unit && npm run test:webmcp",
    "test:unit": "node --experimental-strip-types --test tests/harmonize.test.ts",
    "test:webmcp": "node --test tests/webmcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.105.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agent9AI/hitch.git"
  },
  "homepage": "https://hitch.agent9.dev"
}
